# MongoDB
MONGODB_URI=mongodb+srv://user:pass@host/dbname

# LeetCode default username (used as fallback solver identity in /api/problem)
LC_USERNAME=tedvu

# Notification service (Java Spring Boot backend)
# Set ENABLE_SQS_NOTIFICATIONS=true to route through Java backend + AWS SQS
# Leave unset or false to use the original Next.js-only flow
ENABLE_SQS_NOTIFICATIONS=false
NOTIFICATION_SERVICE_URL=http://localhost:8080
